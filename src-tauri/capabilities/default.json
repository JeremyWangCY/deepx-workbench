{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DeepX local Harness shell",
  "windows": ["main", "winbar"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "core:default",
    "allow-window-action",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "opener:default",
    "allow-runtime-status",
    "allow-update-status",
    "allow-update-deepx",
    "allow-initialize-harness",
    "allow-launch-harness",
    "allow-show-harness",
    "allow-reload-harness",
    "allow-update-harness",
    "allow-marketplace-status",
    "allow-install-marketplace"
  ]
}